<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- ── Run Audit Wizard ── -->
    <record id="view_run_audit_wizard_form" model="ir.ui.view">
        <field name="name">run.audit.wizard.form</field>
        <field name="model">run.audit.wizard</field>
        <field name="arch" type="xml">
            <form string="Ejecutar diagnóstico de auditoría">
                <sheet>
                    <div class="oe_title">
                        <h2>Escanear instancia del cliente</h2>
                    </div>
                    <group>
                        <field name="project_id" readonly="1"/>
                        <field name="audit_mode" readonly="1"/>
                    </group>

                    <group string="Subir backup"
                          invisible="audit_mode != 'backup'">
                        <field name="backup_file" widget="binary" filename="backup_filename"
                               required="audit_mode == 'backup'"/>
                        <field name="backup_filename" invisible="1"/>
                    </group>

                    <group string="¿Qué escanear?">
                        <group>
                            <field name="scan_modules"/>
                            <field name="scan_fields"/>
                        </group>
                        <group>
                            <field name="scan_models"/>
                            <field name="scan_volume"/>
                        </group>
                        <field name="generate_effort" colspan="2"/>
                    </group>

                    <group string="Resultado del escaneo"
                          invisible="not scan_done">
                        <field name="scan_log" nolabel="1" readonly="1"
                               style="font-family: monospace; font-size: 12px;"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_scan" string="Iniciar escaneo" type="object"
                            class="btn-primary"
                            invisible="scan_done"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Generate Report Wizard ── -->
    <record id="view_generate_report_wizard_form" model="ir.ui.view">
        <field name="name">generate.report.wizard.form</field>
        <field name="model">generate.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar informe PDF">
                <sheet>
                    <group>
                        <field name="project_id" readonly="1"/>
                        <field name="report_type" widget="radio"/>
                    </group>
                    <group string="Secciones a incluir">
                        <field name="include_modules"/>
                        <field name="include_fields"/>
                        <field name="include_models"/>
                        <field name="include_volume"/>
                        <field name="include_effort"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_pdf" string="Generar PDF" type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</data>
</odoo>
