<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <record id="res_config_settings_view_migration_auditor" model="ir.ui.view">
        <field name="name">res.config.settings.view.migration.auditor</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Migration Auditor"
                     string="Migration Auditor"
                     name="migration_auditor">

                    <block title="Configuración financiera" name="migration_auditor_financial">
                        <setting string="Moneda por defecto" id="migration_auditor_currency"
                                 help="Moneda usada por defecto en nuevos proyectos de auditoría.">
                            <field name="auditor_default_currency_id"/>
                        </setting>
                        <setting string="Tarifa hora" id="migration_auditor_rate"
                                 help="Tarifa horaria por defecto en nuevos proyectos.">
                            <field name="auditor_default_hourly_rate"/>
                        </setting>
                        <setting string="Partner por defecto" id="migration_auditor_partner">
                            <field name="auditor_default_partner_id"/>
                        </setting>
                    </block>

                    <block title="Producto de servicio" name="migration_auditor_products">
                        <setting string="Producto por defecto" id="migration_auditor_product"
                                 help="Fallback cuando una categoría no tiene producto asignado.">
                            <field name="auditor_default_product_id"/>
                        </setting>
                        <setting id="migration_auditor_create_products">
                            <button name="action_create_default_products"
                                    type="object"
                                    string="Crear productos por categoría automáticamente"
                                    class="btn btn-secondary"/>
                        </setting>
                    </block>

                    <block title="Producto por categoría de esfuerzo" name="migration_auditor_categories">
                        <setting id="migration_auditor_category_map">
                            <button name="%(migration_auditor.action_audit_category_product)d"
                                    type="action"
                                    string="Gestionar mapeo de productos por categoría →"
                                    class="btn btn-link p-0"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

</data>
</odoo>
