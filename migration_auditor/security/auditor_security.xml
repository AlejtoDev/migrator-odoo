<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_migration_auditor" model="ir.module.category">
            <field name="name">Migration Auditor</field>
            <field name="sequence">81</field>
        </record>

        <record id="privilege_auditor_user" model="res.groups.privilege">
            <field name="name">Migration Auditor User</field>
            <field name="category_id" ref="module_category_migration_auditor"/>
        </record>

        <record id="group_auditor_user" model="res.groups">
            <field name="name">Auditor</field>
            <field name="privilege_id" ref="privilege_auditor_user"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
