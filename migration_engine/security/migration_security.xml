<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_migration" model="ir.module.category">
            <field name="name">Migration Engine</field>
            <field name="sequence">80</field>
        </record>

        <record id="privilege_migration_user" model="res.groups.privilege">
            <field name="name">Migration Engine User</field>
            <field name="category_id" ref="module_category_migration"/>
        </record>

        <record id="privilege_migration_manager" model="res.groups.privilege">
            <field name="name">Migration Engine Manager</field>
            <field name="category_id" ref="module_category_migration"/>
        </record>

        <record id="group_migration_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="privilege_id" ref="privilege_migration_user"/>
        </record>

        <record id="group_migration_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_migration_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_migration_user'))]"/>
        </record>
    </data>
</odoo>
